{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:data": "node scripts/validate-research.mjs",
    "test:markdown": "node scripts/validate-markdown.mjs",
    "validate": "npm run test:data && npm run test:markdown && npm run lint"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "github-slugger": "^2.0.0"
  }
}
