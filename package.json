{
  "name": "nextchina-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/prepare-garden.mjs",
    "predev": "node scripts/prepare-garden.mjs && npm run render:assets",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "node scripts/prepare-garden.mjs && npm run render:assets",
    "build": "npm run test:render-assets && npm run validate && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:assets": "wrangler deploy",
    "clean": "rm -rf dist src/generated",
    "prelint": "node scripts/prepare-garden.mjs",
    "lint": "tsc --noEmit",
    "test:data": "node scripts/validate-research.mjs",
    "test:markdown": "node scripts/validate-markdown.mjs",
    "test:garden": "node scripts/validate-garden.mjs && node scripts/test-garden.mjs",
    "test:hubs": "node scripts/test-topic-hubs.mjs",
    "test:knowledge": "node scripts/test-knowledge-units.mjs",
    "test:semantics": "node scripts/test-semantics.mjs",
    "audit:knowledge": "node scripts/audit-knowledge.mjs",
    "test:browser": "playwright test",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "validate": "npm run test:data && npm run test:garden && npm run test:hubs && npm run test:knowledge && npm run test:semantics && npm run test:markdown && npm run lint",
    "render:assets": "node scripts/prepare-markdown.mjs",
    "test:render-assets": "node scripts/test-render-assets.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "@xyflow/react": "12.11.2",
    "elkjs": "0.12.0",
    "katex": "0.16.22",
    "lucide-react": "0.546.0",
    "mermaid": "11.12.0",
    "motion": "12.23.24",
    "prismjs": "1.30.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "github-slugger": "2.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.102.0",
    "unified": "11.0.5",
    "remark-parse": "11.0.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
